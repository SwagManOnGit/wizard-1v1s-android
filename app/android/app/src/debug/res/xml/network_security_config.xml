<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Android blocks cleartext HTTP from API 28 up, which is right for release: the
  duel server is reached over https there. During development the server runs on the machine and is
  reached through `adb reverse tcp:2567 tcp:2567`, so it arrives as http://localhost:2567.

  Only the two loopback names a development machine can be behind are opened; everything else keeps
  the platform default.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <!-- The emulator's alias for the host machine, for when adb reverse is not set up. -->
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
